TELEGRAM_BOT_TOKEN=your_botfather_token
GEMINI_API_KEY=your_gemini_key
# Optional: uses the existing Telegram model default when omitted.
GEMINI_MODEL=gemini-3.8-flash
TELEGRAM_WEBHOOK_SECRET=your_random_telegram_secret

WHATSAPP_ACCESS_TOKEN=your_meta_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_random_whatsapp_verification_token
WHATSAPP_APP_SECRET=your_meta_app_secret
# Set to the supported Graph API version shown in your Meta dashboard (format vNN.0).
WHATSAPP_API_VERSION=
